# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# --- Opção 1: banco no seu computador (pgAdmin) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=sua_senha
PG_DATABASE=estrutura_curricular

# --- Opção 2: banco no Supabase (deixe as linhas acima comentadas ou apagadas) ---
# Use a "connection string" do Supabase, modo Transaction pooler (porta 6543).
# DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Porta do servidor local (opcional)
PORT=3000
